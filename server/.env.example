# Database Connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recoverai?schema=public"

# Server Port
PORT=3001

# Node Environment
NODE_ENV=development

# Groq AI API Key (get from https://console.groq.com)
# When set, the AI engine uses real Groq LLM (llama-3.3-70b-versatile).
# When not set, the app uses the deterministic/rule-based fallback engine.
# IMPORTANT: Never expose this key to the frontend or commit it to Git.
GROQ_API_KEY=
